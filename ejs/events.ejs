<% if (items.length) { %>
<div class="leap-events">
<div class="leap-event-main"><div class="leap-kicker">Announcement</div><h3><a href="<%- items[0].path %>"><%= items[0].title %></a></h3><p><%= items[0].description %></p><div class="leap-readmore">Details &rarr;</div></div>
<% if (items.length > 1) { %>
<div class="leap-event-rest"><% items.slice(1).forEach(function (it) { %><a class="leap-event-item" href="<%- it.path %>"><span><%= it.title %></span><span>&rarr;</span></a><% }); %></div>
<% } %>
</div>
<% } %>
